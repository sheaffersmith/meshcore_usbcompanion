MESHCORE_PORT=/dev/ttyACM1
LOG_DIR=./logs
BOT_SEND_ENABLED=false
BOT_TRIGGER=test
BOT_MAX_MESSAGE_AGE=120
BOT_NAME=MeshBot

# Send the USB companion's flood advertisement each time the bot starts so
# nearby MeshCore clients can discover its correct contact and public key.
ADVERTISE_ON_START=true

# Match the MeshCore app's "Overwrite Oldest" contact behavior. When the
# radio is full, a newly advertised contact replaces only the oldest contact.
OVERWRITE_OLDEST_CONTACTS=true
CONTACT_CAPACITY=350

# Comma-separated exact contact names or full public keys that must never be
# removed by overwrite-oldest contact management.
CONTACT_FAVORITES=smiths16
